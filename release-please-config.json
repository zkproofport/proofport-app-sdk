{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "npm-publish": false,
      "include-component-in-tag": false,
      "draft": false,
      "prerelease": false,
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "perf",
          "section": "Performance"
        },
        {
          "type": "refactor",
          "section": "Refactoring"
        },
        {
          "type": "docs",
          "section": "Documentation",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Miscellaneous",
          "hidden": true
        }
      ],
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "exclude-paths": [
        "packages/core"
      ],
      "last-release-sha": "d036aed22d74874b494ddcc05676c5d68784a16a",
      "release-as": "0.5.0-beta.1"
    },
    "packages/core": {
      "release-type": "node",
      "npm-publish": false,
      "include-component-in-tag": true,
      "draft": false,
      "prerelease": false,
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "perf",
          "section": "Performance"
        },
        {
          "type": "refactor",
          "section": "Refactoring"
        },
        {
          "type": "docs",
          "section": "Documentation",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Miscellaneous",
          "hidden": true
        }
      ],
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "component": "core",
      "last-release-sha": "d036aed22d74874b494ddcc05676c5d68784a16a"
    }
  },
  "plugins": [
    "node-workspace"
  ],
  "commit-search-depth": 50,
  "release-search-depth": 50
}
